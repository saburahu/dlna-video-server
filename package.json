{
  "name": "pt3-recording-server",
  "version": "0.4.4",
  "private": true,
  "description": "家庭内LAN向け録画ファイルUPnP/DLNAメディアサーバー",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=4 test/*.test.ts packaging/*.test.mjs",
    "build": "tsc -p tsconfig.build.json",
    "logs:summary": "tsx src/log-summary.ts",
    "package:windows": "node packaging/build.mjs",
    "package:verify": "node packaging/verify.mjs",
    "audit:public": "node tools/audit-public.mjs",
    "verify:dual-audio": "node tools/verify-dual-audio.mjs",
    "verify:synthetic-http": "node tools/verify-synthetic.mjs --concurrency"
  },
  "dependencies": {
    "aribts": "1.3.5"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=24.22.0"
  },
  "license": "MIT",
  "productName": "DLNA Video Server"
}
